{
  "name": "vote-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "db:local": "wrangler d1 migrations apply vote-tree --local",
    "db:remote": "wrangler d1 migrations apply vote-tree --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
